---
import logoImage from '../assets/images/hanover-and-echols-square-logo.png';
---

<header class="w-full bg-[#02084b] border-b-2 border-[#56aeff] relative z-50">
  <div class="max-w-7xl mx-auto px-6 py-2 md:py-4 flex items-center justify-between">
    
    <!-- Logo -->
    <div style="width: 220px;" class="flex-shrink-0">
      <a href="/"><img src={logoImage.src} alt="Hanover & Echols" /></a>
    </div>

    <!-- Desktop Navigation: Displayed as flex row on desktop, hidden on mobile -->
<nav class="hidden md:flex flex-row items-center gap-6 lg:gap-8">
      <a href="/" class="text-white text-sm font-semibold hover:text-[#00E5FF] uppercase transition-colors whitespace-nowrap">Home</a>
      <a href="/criminal-defense" class="text-white text-sm font-semibold hover:text-[#00E5FF] uppercase transition-colors whitespace-nowrap">Criminal Defense</a>
      <a href="/family-law" class="text-white text-sm font-semibold hover:text-[#00E5FF] uppercase transition-colors whitespace-nowrap">Family Law</a>
      <a href="/personal-injury" class="text-white text-sm font-semibold hover:text-[#00E5FF] uppercase transition-colors whitespace-nowrap">Personal Injury</a>
      <a href="/about-us" class="text-white text-sm font-semibold hover:text-[#00E5FF] uppercase transition-colors whitespace-nowrap">About Us</a>
      <a href="/contact-us" class="text-white text-sm font-semibold hover:text-[#00E5FF] uppercase transition-colors whitespace-nowrap">Contact Us</a>
    </nav>

    <!-- Hamburger Button: Visible only on mobile -->
    <button id="menu-btn" class="md:hidden text-[#00E5FF] focus:outline-none">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#02084b] px-6 pb-6 flex flex-col gap-4 border-b-2 border-[#56aeff]">
    <a href="/" class="text-white uppercase font-semibold">Home</a>
    <a href="/criminal-defense" class="text-white uppercase font-semibold">Criminal Defense</a>
    <a href="/family-law" class="text-white uppercase font-semibold">Family Law</a>
    <a href="/personal-injury" class="text-white uppercase font-semibold">Personal Injury</a>
    <a href="/about-us" class="text-white uppercase font-semibold">About Us</a>
    <a href="/contact-us" class="text-white uppercase font-semibold">Contact Us</a>
  </div>
</header>

<script>
  // Script handles the mobile menu toggle
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>