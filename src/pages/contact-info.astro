---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="Contact Us | Hanover and Echols">
  <Header />

  <main class="bg-[#02084b] min-h-screen py-20">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12">
      
      <!-- Contact Information & Map -->
      <div>
        <h1 class="text-4xl text-[#00E5FF] font-serif mb-6">Contact Information</h1>
        <p class="text-slate-300 mb-8">
          We are ready to assist you with your legal needs. Visit our Dallas office, call us directly, or reach out via the form. We're available 24/7
        </p>
        
        <div class="bg-[#1a237e] p-6 rounded-xl mb-6">
          <h3 class="text-white font-bold mb-2">Our Dallas Office</h3>
          <p class="text-slate-300 text-sm mb-4">1801 McKinney Ave, Suite 400<br/>Dallas, TX 75201</p>
          <p class="text-slate-400 text-sm mb-1">Direct Line 24/7:</p>
          <a href="tel:+14699024621" class="text-[#00E5FF] font-bold text-lg hover:underline">
            +1 469 902 4621
          </a>
        </div>

        <!-- Google Maps Embed -->
        <div class="rounded-xl overflow-hidden shadow-lg w-full">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3354.1348364080873!2d-96.80680512487776!3d32.78868388339064!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x864e993b3e87af69%3A0xf061439b471428f4!2s1801%20McKinney%20Ave%2C%20Dallas%2C%20TX%2075201%2C%20USA!5e0!3m2!1sen!2sza!4v1782852955185!5m2!1sen!2sza" 
            width="100%" 
            height="500" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="strict-origin-when-cross-origin">
          </iframe>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-[#1a237e] p-8 rounded-xl">
        <ContactForm />
      </div>
      
    </div>
  </main>

  <Footer />
</BaseLayout>