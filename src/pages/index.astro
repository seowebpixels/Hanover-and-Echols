---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesMatrix from '../components/ServicesMatrix.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

// STAGE 1 LOGO & HERO IMPORTS
import logoImage from '../assets/images/hanover-and-echols-square-logo.png';
import skylineImage from '../assets/images/dallas-skyline-hero-image.png';

// STAGE 2 DIVIDER & COLUMN CARD IMPORTS
import heroShield from '../assets/images/hero-shield.png';
import criminalIcon from '../assets/images/criminal-defense.png';
import familyIcon from '../assets/images/family-law.png';
import injuryIcon from '../assets/images/personal-injury.png';

// STAGE 2 YELLOW TRUST SIGNAL IMPORTS
import clientIcon from '../assets/images/client-focused.png';
import experienceIcon from '../assets/images/experienced.png';
import discreetIcon from '../assets/images/discreet.png';
import resultsIcon from '../assets/images/results-driven.png';

// STAGE 3 FEATURE VALUE ROW IMPORTS
import yearsIcon from '../assets/images/thirty-plus-years-of-experience.png';
import casesIcon from '../assets/images/hundres-of-successful-cases.png';
import ratingIcon from '../assets/images/five-star-client-satisfaction.png';
import representationIcon from '../assets/images/personalized-representation.png';

// STAGE 4 TEAM PHOTO AND LAW BADGES
import teamPhoto from '../assets/images/team-of-attorneys.jpg';
import superLawyers from '../assets/images/super-lawyers-logo.png';
import nbtaLogo from '../assets/images/national-board-of-trial-advocacy-logo.png';
import abaLogo from '../assets/images/american-bar-association-logo.png';
import top100Logo from '../assets/images/top-one-hundred-trial-lawyers-logo.webp';
import stateBarLogo from '../assets/images/state-bar-of-texas-logo.png';

// TESTIMONIAL UPDATE 
import stars from '../assets/images/five-stars.png';
import googleLogo from '../assets/images/google-logo.png';

// FOOTER UPDATE 
import logo from '../assets/images/hanover-and-echols-square-logo.png';
import socialIcons from '../assets/images/social-media-icons.png';
---

<!-- Embed Cormorant Garamond for premium editorial typography -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&display=swap" rel="stylesheet">

<BaseLayout title="Hanover & Echols, LLC | Premium DFW Legal Counsel">
  <div class="w-full bg-[#02084b] min-h-screen flex flex-col text-white">
    
  <Header/>
  
    <!-- HERO BANNER IMAGE FRAME -->
<section class="w-full relative overflow-hidden z-10">
  <div class="w-full aspect-[8/9] md:aspect-[21/9] lg:h-[500px]">
    <Image 
      src={skylineImage} 
      alt="Dallas Skyline at Night" 
      class="w-full h-full object-cover object-center block leading-none"
      format="avif"
      quality="high"
      fetchpriority="high"
    />
  </div>
</section>

    <!-- STAGE 2 CONTAINER -->
    <section class="w-full bg-[#02084b] text-white px-6 py-20 flex flex-col items-center">
      
      <!-- Typography Styling (Ensured Tighter Letter Spacing) -->
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

      <p 
        style="font-family: 'Cormorant Garamond', serif !important;" 
        class="text-2xl md:text-3xl lg:text-4xl font-medium tracking-wider text-slate-200 mb-6 text-center"
      >
        Dedicated. Strategic. Results Driven.
      </p>

      <!-- SHIELD DIVIDER -->
      <div class="w-full max-w-2xl flex items-center justify-center gap-6 mb-12">
        <div class="h-[1px] flex-1 bg-gradient-to-r from-transparent via-white/40 to-white/70"></div>
        <div class="w-50 h-50 flex-shrink-0">
          <img src={heroShield.src} alt="Shield Icon" class="w-full h-full object-contain filter drop-shadow-lg" />
        </div>
        <div class="h-[1px] flex-1 bg-gradient-to-l from-transparent via-white/40 to-white/70"></div>
      </div>

      <!-- MAIN CORE COMMITMENT HEADLINE -->
      <h2 class="text-3xl md:text-4xl font-normal tracking-wider text-center mb-8 uppercase max-w-4xl leading-snug">
        Your Case. Your Future. Our Commitment.
      </h2>

      <!-- INTRODUCTION SUBTEXT DESCRIPTION -->
      <p class="text-base md:text-lg font-light text-slate-300 text-center max-w-3xl leading-relaxed mb-20">
        At Hanover and Echols, we provide personalized legal representation with the attention, experience, and results that you deserve.
      </p>

      <!-- THREE-COLUMN SERVICE CARDS MATRIX: Native CSS Grid Bypass -->
      <div 
        style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; width: 100%; max-width: 80rem; margin-bottom: 8rem; align-items: stretch;"
      >
        
        <!-- CARD 1: CRIMINAL DEFENSE -->
        <div class="border border-cyan-400/20 rounded-[2.5rem] bg-[#02084b]/60 backdrop-blur-sm p-8 md:p-10 flex flex-col items-center text-center shadow-xl hover:border-[#00E5FF] hover:shadow-[0_0_30px_rgba(0,229,255,0.45)] transition-all duration-300 group">
          <h3 class="text-2xl font-serif text-white mb-8">Criminal Defense</h3>
          <div style="width: 150px; height: 150px;" class="rounded-full border border-white/20 flex items-center justify-center bg-[#010636] group-hover:border-[#00E5FF]/50 transition-colors duration-300">
            <img src={criminalIcon.src} alt="Criminal Defense Scale" style="transform: scale(2.7);" class="w-full h-full object-contain" />
          </div>
          <p class="text-sm text-slate-300 font-light leading-relaxed my-8 max-w-[260px]">
            Aggressive defense for those facing criminal charges. We protect your rights and your future.
          </p>
          <a href="/criminal-defense" class="mt-auto flex items-center gap-2 text-xs font-semibold tracking-widest text-white uppercase hover:text-[#00E5FF] transition-colors">
            Learn More <span class="text-lg tracking-normal group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
          </a>
        </div>

        <!-- CARD 2: FAMILY LAW -->
        <div class="border border-cyan-400/20 rounded-[2.5rem] bg-[#02084b]/60 backdrop-blur-sm p-8 md:p-10 flex flex-col items-center text-center shadow-xl hover:border-[#00E5FF] hover:shadow-[0_0_30px_rgba(0,229,255,0.45)] transition-all duration-300 group">
          <h3 class="text-2xl font-serif text-white mb-8">Family Law</h3>
          <div style="width: 150px; height: 150px;" class="rounded-full border border-white/20 flex items-center justify-center bg-[#010636] group-hover:border-[#00E5FF]/50 transition-colors duration-300">
            <img src={familyIcon.src} alt="Family Law Silhouette" style="transform: scale(2.5);" class="w-full h-full object-contain" />
          </div>
          <ul class="text-sm text-slate-300 font-light leading-loose text-left inline-block my-8 list-disc list-inside max-w-[260px]">
            <li>Divorce Representation</li>
            <li>Prenuptial Agreement</li>
            <li>Child Custody</li>
            <li>Spousal Support</li>
            <li>Divorce Mediation</li>
          </ul>
          <a href="/family-law" class="mt-auto flex items-center gap-2 text-xs font-semibold tracking-widest text-white uppercase hover:text-[#00E5FF] transition-colors">
            Learn More <span class="text-lg tracking-normal group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
          </a>
        </div>

        <!-- CARD 3: PERSONAL INJURY -->
        <div class="border border-cyan-400/20 rounded-[2.5rem] bg-[#02084b]/60 backdrop-blur-sm p-8 md:p-10 flex flex-col items-center text-center shadow-xl hover:border-[#00E5FF] hover:shadow-[0_0_30px_rgba(0,229,255,0.45)] transition-all duration-300 group">
          <h3 class="text-2xl font-serif text-white mb-8">Personal Injury</h3>
          <div style="width: 150px; height: 150px;" class="rounded-full border border-white/20 flex items-center justify-center bg-[#010636] group-hover:border-[#00E5FF]/50 transition-colors duration-300">
            <img src={injuryIcon.src} alt="Personal Injury Cast" style="transform: scale(2.6);" class="w-full h-full object-contain" />
          </div>
          <p class="text-sm text-slate-300 font-light leading-relaxed my-8 max-w-[260px]">
            Fighting for the compensation you deserve after an injury caused by someone else's negligence.
          </p>
          <a href="/personal-injury" class="mt-auto flex items-center gap-2 text-xs font-semibold tracking-widest text-white uppercase hover:text-[#00E5FF] transition-colors">
            Learn More <span class="text-lg tracking-normal group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
          </a>
        </div>

      </div>

      <!-- TRUST & BRAND FEATURES: Forced 4-Column Horizontal Row Bypass -->
      <div 
        style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; width: 100%; max-width: 80rem; pt: 4rem; border-top: 1px solid rgba(255,255,255,0.1);"
        class="pt-16"
      >
        
        <!-- Feature 1: Client Focused -->
        <div class="flex flex-col items-center text-center p-4 rounded-2xl hover:bg-white/5 transition-colors duration-200 group">
          <!-- Maximum Enlarged Icon Container -->
          <div class="w-32 h-32 flex-shrink-0 bg-white/5 rounded-2xl p-4 flex items-center justify-center border border-white/10 group-hover:border-cyan-400/50 group-hover:bg-[#010636] transition-all duration-300 mb-5 shadow-xl overflow-hidden">
            <img src={clientIcon.src} alt="Shield Check Icon" style="transform: scale(2.2);" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col items-center">
            <h4 class="text-sm font-semibold uppercase tracking-widest text-white mb-2">Client Focused</h4>
            <p class="text-xs text-slate-300 font-light leading-relaxed max-w-[200px]">
              Personalized attention for every case.
            </p>
          </div>
        </div>

        <!-- Feature 2: Experienced -->
        <div class="flex flex-col items-center text-center p-4 rounded-2xl hover:bg-white/5 transition-colors duration-200 group">
          <!-- Maximum Enlarged Icon Container -->
          <div class="w-32 h-32 flex-shrink-0 bg-white/5 rounded-2xl p-4 flex items-center justify-center border border-white/10 group-hover:border-cyan-400/50 group-hover:bg-[#010636] transition-all duration-300 mb-5 shadow-xl overflow-hidden">
            <img src={experienceIcon.src} alt="Courthouse Pillars Icon" style="transform: scale(2.2);" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col items-center">
            <h4 class="text-sm font-semibold uppercase tracking-widest text-white mb-2">Experienced</h4>
            <p class="text-xs text-slate-300 font-light leading-relaxed max-w-[200px]">
              Decades of combined legal experience.
            </p>
          </div>
        </div>

        <!-- Feature 3: Discreet -->
        <div class="flex flex-col items-center text-center p-4 rounded-2xl hover:bg-white/5 transition-colors duration-200 group">
          <!-- Maximum Enlarged Icon Container -->
          <div class="w-32 h-32 flex-shrink-0 bg-white/5 rounded-2xl p-4 flex items-center justify-center border border-white/10 group-hover:border-cyan-400/50 group-hover:bg-[#010636] transition-all duration-300 mb-5 shadow-xl overflow-hidden">
            <img src={discreetIcon.src} alt="Handshake Icon" style="transform: scale(2.2);" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col items-center">
            <h4 class="text-sm font-semibold uppercase tracking-widest text-white mb-2">Discreet</h4>
            <p class="text-xs text-slate-300 font-light leading-relaxed max-w-[200px]">
              Your case is completely confidential.
            </p>
          </div>
        </div>

        <!-- Feature 4: Results Driven -->
        <div class="flex flex-col items-center text-center p-4 rounded-2xl hover:bg-white/5 transition-colors duration-200 group">
          <!-- Maximum Enlarged Icon Container -->
          <div class="w-32 h-32 flex-shrink-0 bg-white/5 rounded-2xl p-4 flex items-center justify-center border border-white/10 group-hover:border-cyan-400/50 group-hover:bg-[#010636] transition-all duration-300 mb-5 shadow-xl overflow-hidden">
            <img src={resultsIcon.src} alt="Trophy Icon" style="transform: scale(2.2);" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col items-center">
            <h4 class="text-sm font-semibold uppercase tracking-widest text-white mb-2">Results Driven</h4>
            <p class="text-xs text-slate-300 font-light leading-relaxed max-w-[200px]">
              We fight for the best possible outcome.
            </p>
          </div>
        </div>

      </div>

    </section>

    <!-- STAGE 3 CONTAINER: "Why Clients Choose Us" -->
    <section class="w-full bg-[#02084b] text-white px-6 py-20 flex flex-col items-center">
      
      <!-- HEADING: Trusted Legal Counsel -->
      <h2 class="text-3xl font-serif text-white mb-20 text-center tracking-tight leading-snug">
        Trusted Legal Counsel When It Matters Most
      </h2>

      <!-- STAGE 3 FOUR-COLUMN VALUE ICONS: Forced Horizontal Row Bypass -->
      <div 
        style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; width: 100%; max-width: 80rem; margin-bottom: 50px; justify-items: center;"
      >
        
        <!-- Value 1: 30 Plus Years of Experience -->
        <div class="flex flex-col items-center text-center max-w-[260px] group">
          <div style="width: 150px; height: 150px;" class="mb-6 rounded-full border border-white/20 flex items-center justify-center bg-[#010636] group-hover:border-[#00E5FF]/50 transition-colors duration-300">
            <img src={yearsIcon.src} alt="30 Plus Years of Experience Icon" style="transform: scale(2.8);" class="w-full h-full object-contain" />
          </div>
          <p class="text-xs text-slate-300 font-semibold tracking-widest uppercase">
            30 Plus Years of Experience
          </p>
        </div>

        <!-- Value 2: Hundreds of Successful Cases -->
        <div class="flex flex-col items-center text-center max-w-[260px] group">
          <div style="width: 150px; height: 150px;" class="mb-6 rounded-full border border-white/20 flex items-center justify-center bg-[#010636] group-hover:border-[#00E5FF]/50 transition-colors duration-300">
            <img src={casesIcon.src} alt="Hundreds of Successful Cases Icon" style="transform: scale(2.8);" class="w-full h-full object-contain" />
          </div>
          <p class="text-xs text-slate-300 font-semibold tracking-widest uppercase">
            Hundreds of Successful Cases
          </p>
        </div>

        <!-- Value 3: Five-Star Client Satisfaction -->
        <div class="flex flex-col items-center text-center max-w-[260px] group">
          <div style="width: 150px; height: 150px;" class="mb-6 rounded-full border border-white/20 flex items-center justify-center bg-[#010636] group-hover:border-[#00E5FF]/50 transition-colors duration-300">
            <img src={ratingIcon.src} alt="Five-Star Client Satisfaction Icon" style="transform: scale(2.8);" class="w-full h-full object-contain" />
          </div>
          <p class="text-xs text-slate-300 font-semibold tracking-widest uppercase">
            Five-Star Client Satisfaction
          </p>
        </div>

        <!-- Value 4: Personalized Representation -->
        <div class="flex flex-col items-center text-center max-w-[260px] group">
          <div style="width: 150px; height: 150px;" class="mb-6 rounded-full border border-white/20 flex items-center justify-center bg-[#010636] group-hover:border-[#00E5FF]/50 transition-colors duration-300">
            <img src={representationIcon.src} alt="Personalized Representation Icon" style="transform: scale(2.8);" class="w-full h-full object-contain" />
          </div>
          <p class="text-xs text-slate-300 font-semibold tracking-widest uppercase">
            Personalized Representation
          </p>
        </div>

      </div>

      <!-- HEADING: Why Clients Choose Us -->
      <h2 class="text-3xl font-serif text-white mb-10 text-center tracking-tight leading-snug">
        Why Clients Choose Hanover and Echols Legal
      </h2>

      <!-- DESCRIPTION BLOCK -->
      <div class="w-full max-w-4xl text-center mb-16 leading-relaxed">
        <p class="text-sm md:text-base font-light text-slate-300">
          We provide strategic, results-driven legal representation with the personalized attention only a boutique law firm can offer. Every case is handled directly by an experienced attorney committed to protecting your interests.
        </p>
      </div>

      <!-- TWO-COLUMN Call to Action Matrix: Using forced grid horizontal bypass -->
      <div 
        style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4rem; width: 100%; max-width: 7xl; justify-items: center; align-items: start;"
      >
        
        <!-- LEFT: Firm Value List -->
        <div class="flex flex-col text-slate-300 text-sm md:text-base font-light leading-loose space-y-1">
          <p class="flex items-center gap-3">
            <span class="text-xs">✓</span> Direct Attorney Access
          </p>
          <p class="flex items-center gap-3">
            <span class="text-xs">✓</span> Tailored Legal Strategies
          </p>
          <p class="flex items-center gap-3">
            <span class="text-xs">✓</span> Transparent Communication
          </p>
          <p class="flex items-center gap-3">
            <span class="text-xs">✓</span> Aggressive Advocacy
          </p>
          <p class="flex items-center gap-3">
            <span class="text-xs">✓</span> Confidential Representation
          </p>
        </div>

        <!-- RIGHT: Two Dynamic Buttons -->
        <div class="flex flex-col gap-6 w-full max-w-[420px]">
          
          <!-- BUTTON 1: Request Case Review (Blue) -->
          <a 
            href="/contact-us" 
            class="block w-full py-5 px-8 rounded-xl bg-[#00E5FF] hover:bg-[#00E5FF]/80 text-center text-white text-xs font-semibold tracking-widest uppercase shadow-[0_0_15px_rgba(0,229,255,0.3)] transition-all duration-300 group"
          >
            Request a Free Confidential Case Review <span class="group-hover:translate-x-1.5 transition-transform inline-block ml-1">&rarr;</span>
          </a>

          <!-- BUTTON 2: ACTIVE Click-to-Call (Yellow) -->
          <a 
            href="tel:+14699024621" 
            class="block w-full py-5 px-8 rounded-xl bg-[#FDD835] hover:bg-[#FDD835]/80 text-center text-[#010636] text-xs font-bold tracking-wider uppercase transition-all duration-300 shadow-xl"
          >
            Call Us Today – +1 469 902 4621
          </a>

        </div>

      </div>

    </section>

  </div>

  <section class="max-w-4xl mx-auto px-6 py-20 text-white">
  <h2 class="text-4xl font-serif mb-6">Criminal Defense</h2>
  <h3 class="text-2xl font-medium mb-8 text-slate-200">Aggressive Representation in Dallas County Courts</h3>
  
  <div class="space-y-6 text-slate-300 mb-12 leading-relaxed">
    <p>Facing criminal charges in North Texas can completely upend your life, leaving you to face an aggressive prosecution and a complex legal system alone. Our dedicated Dallas criminal defense attorneys provide the relentless, strategic legal representation required to shield your rights, protect your freedom, and safeguard your future reputation. Whether you are dealing with a standard misdemeanor, a complex federal investigation, or high-stakes felony charges in the DFW metroplex, an experienced criminal defense lawyer in Dallas will immediately take control of your situation.</p>
    <p>We don't simply accept the prosecution's version of events. Our legal team meticulously deconstructs the state's case from the ground up—uncovering constitutional violations, challenging unlawful law enforcement procedures, and analyzing every piece of forensic evidence available. From navigating the initial arraignment to fiercely advocating for you before Dallas County judges and juries, we are committed to building a robust defense tailored to the specific facts of your case. Our singular focus is achieving the best possible legal resolution, whether that involves securing a complete dismissal of charges, negotiating a significant reduction, or presenting a powerhouse defense at trial.</p>
  </div>

  <h4 class="text-xl font-bold mb-6">Key Practice Areas & Defense Strategies</h4>
  <ul class="space-y-4 mb-10 text-slate-300">
    <li><strong>Aggressive Felony & Misdemeanor Defense:</strong> Providing relentless representation for individuals facing state or federal charges across the DFW metroplex.</li>
    <li><strong>Meticulous Case Analysis & Investigation:</strong> Deconstructing the prosecution's evidence, uncovering constitutional violations, and challenging unlawful law enforcement procedures.</li>
    <li><strong>DWI & Traffic Offense Advocacy:</strong> Protecting your driving privileges, challenging breath and blood tests, and fighting to keep your record clean in Dallas County.</li>
    <li><strong>Drug Charges & Federal Offenses:</strong> Navigating complex state and federal drug laws with sophisticated strategies designed to secure dismissals or reduced charges.</li>
    <li><strong>Relentless Trial & Courtroom Representation:</strong> Standing fiercely by your side from the initial arraignment all the way through a jury verdict to protect your future.</li>
  </ul>

  <a href="/criminal-defense" class="inline-block bg-[#00E5FF] hover:bg-[#00E5FF]/80 text-[#010636] font-bold py-3 px-8 rounded-lg uppercase tracking-widest transition-all">
    Learn More
  </a>
</section>

<section class="max-w-5xl mx-auto px-6 py-20 text-white">
  <!-- Top Buttons -->
  <div class="flex gap-6 mb-16">
    <a href="/contact-us" class="py-4 px-8 bg-[#00E5FF] hover:bg-[#00E5FF]/80 text-[#010636] font-bold rounded-lg uppercase tracking-widest transition-all">Request a Free Confidential Case Review</a>
    <a href="tel:+14699024621" class="py-4 px-8 bg-[#FDD835] text-[#010636] font-bold rounded-lg uppercase tracking-widest transition-all">Call Us Today – +1 469 902 4621</a>
  </div>

  <!-- Heading & Text -->
  <h2 class="text-4xl font-serif mb-8">Family Law</h2>
  <p class="text-slate-300 leading-relaxed mb-16 max-w-4xl">
    Navigating legal matters that impact your home and future can be emotionally demanding and legally complex. Our dedicated Dallas family law attorneys provide compassionate guidance and assertive legal representation to help you protect what matters most. Whether you are facing a contested divorce, negotiating complex property division, or restructuring your family dynamic, an experienced family law attorney in Dallas will safeguard your interests. We understand the high stakes involved in Texas family courts, and we are committed to delivering tailored, strategic legal solutions that provide clarity, stability, and peace of mind for you and your children.
  </p>

  <!-- Horizontal Boxes -->
  <div class="grid md:grid-cols-2 gap-8">
    {[
      { title: "Divorce Representation", body: "Ending a marriage involves high-stakes decisions regarding asset division, debt allocation, and long-term financial security. Our Dallas divorce lawyers provide aggressive representation for both contested and uncontested divorces in North Texas. We meticulously analyze complex marital estates, protect separate property, and fight to ensure an equitable distribution under Texas community property laws, allowing you to move forward with financial confidence." },
      { title: "Prenuptial Agreements", body: "A well-crafted marital agreement provides financial clarity and protects personal assets before entering a marriage. We draft enforceable, comprehensive Dallas prenuptial agreements tailored to Texas family code standards. By clearly defining separate property rights, business interests, and future financial expectations, we help couples build a secure foundation and prevent costly, stressful disputes down the road." },
      { title: "Child Custoday", body: "Nothing is more critical than protecting your parental rights and the well-being of your children. Navigating child custody in Dallas County requires a strategic approach focused on the best interests of the child, establishing workable joint managing conservatorships, and securing fair visitation schedules. We advocate fiercely for your relationship with your children, whether establishing initial custody agreements or pursuing modifications to existing court orders." },
      { title: "Spousal Support & Alimony", body: "Achieving post-divorce financial stability requires a fair assessment of ongoing support. While contractual alimony and court-ordered spousal maintenance in Texas have strict eligibility thresholds, our legal team ensures your financial needs or contributions are accurately presented. We fight to secure fair spousal support in Dallas, ensuring that factors like earning capacity, marriage duration, and financial sacrifice are heavily prioritized." },
      { title: "Divorce Mediation", body: "For couples seeking a less adversarial, more cost-effective path to resolving marital disputes, mediation offers a private alternative to a public courtroom battle. Our skilled Dallas divorce mediators facilitate constructive communication, helping both parties reach mutually beneficial agreements on asset division and co-parenting structures while ensuring your rights remain fully protected throughout the negotiation process." },
      { title: "Adoption", body: "Welcoming a child into your home is a joyous milestone, but navigating Texas adoption laws requires precise legal execution. Our Dallas adoption attorneys guide stepparents, relatives, and growing families through every phase of the legal process, from private placements to agency adoptions. We handle all complex court filings, background checks, and home study requirements, ensuring your parental rights are securely established in Dallas County courts." }
    ].map(box => (
      <div class="border-2 border-cyan-500 rounded-[2rem] p-8 bg-[#02084b] hover:border-cyan-400 hover:shadow-[0_0_30px_rgba(6,232,255,0.8)] transition-all duration-300">
        <p class="text-slate-300 leading-relaxed text-sm">{box.body}</p>
      </div>
    ))}
  </div>

  <a href="/family-law" class="inline-block mt-8 bg-[#00E5FF] hover:bg-[#00E5FF]/80 text-[#010636] font-bold py-3 px-8 rounded-lg uppercase tracking-widest transition-all">
  Learn More
</a>
</section>

