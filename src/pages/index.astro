---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesMatrix from '../components/ServicesMatrix.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

// STAGE 1 LOGO & HERO IMPORTS
import logoImage from '../assets/images/hanover-and-echols-square-logo.png';
import skylineImage from '../assets/images/dallas-skyline-hero-image.png';

// STAGE 2 DIVIDER & COLUMN CARD IMPORTS
import heroShield from '../assets/images/hero-shield.png';
import criminalIcon from '../assets/images/criminal-defense.png';
import familyIcon from '../assets/images/family-law.png';
import injuryIcon from '../assets/images/personal-injury.png';

// STAGE 2 YELLOW TRUST SIGNAL IMPORTS
import clientIcon from '../assets/images/client-focused.png';
import experienceIcon from '../assets/images/experienced.png';
import discreetIcon from '../assets/images/discreet.png';
import resultsIcon from '../assets/images/results-driven.png';

// STAGE 3 FEATURE VALUE ROW IMPORTS
import yearsIcon from '../assets/images/thirty-plus-years-of-experience.png';
import casesIcon from '../assets/images/hundres-of-successful-cases.png';
import ratingIcon from '../assets/images/five-star-client-satisfaction.png';
import representationIcon from '../assets/images/personalized-representation.png';

// STAGE 4 TEAM PHOTO AND LAW BADGES
import teamPhoto from '../assets/images/team-of-attorneys.jpg';
import superLawyers from '../assets/images/super-lawyers-logo.png';
import nbtaLogo from '../assets/images/national-board-of-trial-advocacy-logo.png';
import abaLogo from '../assets/images/american-bar-association-logo.png';
import top100Logo from '../assets/images/top-one-hundred-trial-lawyers-logo.webp';
import stateBarLogo from '../assets/images/state-bar-of-texas-logo.png';

// TESTIMONIAL UPDATE 
import stars from '../assets/images/five-stars.png';
import googleLogo from '../assets/images/google-logo.png';

// FOOTER UPDATE 
import logo from '../assets/images/hanover-and-echols-square-logo.png';
import socialIcons from '../assets/images/social-media-icons.png';
---

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&display=swap" rel="stylesheet">

<BaseLayout title="Hanover & Echols, LLC | Premium DFW Legal Counsel">
  <div class="relative w-full bg-[#02084b] min-h-screen flex flex-col text-white">
    
    <Header/>
  
    <section class="hero-wrapper w-full relative overflow-hidden z-10 pt-[80px]">
      <div class="w-full aspect-[8/9] md:aspect-[21/9] lg:h-[500px]">
        <Image 
          src={skylineImage} 
          alt="Dallas Skyline at Night" 
          class="w-full h-full object-cover object-center block leading-none"
        />
      </div>
    </section>

    <!-- STAGE 2 CONTAINER -->
    <section class="w-full bg-[#02084b] text-white px-6 pt-20 pb-20 flex flex-col items-center">
      
      <p 
        style="font-family: 'Cormorant Garamond', serif !important;" 
        class="text-2xl md:text-3xl lg:text-4xl font-medium tracking-wider text-slate-200 mb-6 text-center"
      >
        Dedicated. Strategic. Results Driven.
      </p>

      <div class="w-full max-w-2xl flex items-center justify-center gap-6 mb-12">
        <div class="h-[1px] flex-1 bg-gradient-to-r from-transparent via-white/40 to-white/70"></div>
        <div class="w-50 h-50 flex-shrink-0">
          <img src={heroShield.src} alt="Shield Icon" class="w-full h-full object-contain filter drop-shadow-lg" />
        </div>
        <div class="h-[1px] flex-1 bg-gradient-to-l from-transparent via-white/40 to-white/70"></div>
      </div>

      <h2 class="text-3xl md:text-4xl font-normal tracking-wider text-center mb-8 uppercase max-w-4xl leading-snug">
        Your Case. Your Future. Our Commitment.
      </h2>

      <p class="text-base md:text-lg font-light text-slate-300 text-center max-w-3xl leading-relaxed mb-20">
        At Hanover and Echols, we provide personalized legal representation with the attention, experience, and results that you deserve.
      </p>

      <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; width: 100%; max-width: 80rem; margin-bottom: 8rem; align-items: stretch;">
        
        <div class="border border-cyan-400/20 rounded-[2.5rem] bg-[#02084b]/60 backdrop-blur-sm p-8 md:p-10 flex flex-col items-center text-center shadow-xl hover:border-[#00E5FF] hover:shadow-[0_0_30px_rgba(0,229,255,0.45)] transition-all duration-300 group">
          <h3 class="text-2xl font-serif text-white mb-8">Criminal Defense</h3>
          <div style="width: 150px; height: 150px;" class="rounded-full border border-white/20 flex items-center justify-center bg-[#010636] group-hover:border-[#00E5FF]/50 transition-colors duration-300">
            <img src={criminalIcon.src} alt="Criminal Defense Scale" style="transform: scale(2.7);" class="w-full h-full object-contain" />
          </div>
          <p class="text-sm text-slate-300 font-light leading-relaxed my-8 max-w-[260px]">
            Aggressive defense for those facing criminal charges. We protect your rights and your future.
          </p>
          <a href="/criminal-defense" class="mt-auto flex items-center gap-2 text-xs font-semibold tracking-widest text-white uppercase hover:text-[#00E5FF] transition-colors">
            Learn More <span class="text-lg tracking-normal group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
          </a>
        </div>

        <div class="border border-cyan-400/20 rounded-[2.5rem] bg-[#02084b]/60 backdrop-blur-sm p-8 md:p-10 flex flex-col items-center text-center shadow-xl hover:border-[#00E5FF] hover:shadow-[0_0_30px_rgba(0,229,255,0.45)] transition-all duration-300 group">
          <h3 class="text-2xl font-serif text-white mb-8">Family Law</h3>
          <div style="width: 150px; height: 150px;" class="rounded-full border border-white/20 flex items-center justify-center bg-[#010636] group-hover:border-[#00E5FF]/50 transition-colors duration-300">
            <img src={familyIcon.src} alt="Family Law Silhouette" style="transform: scale(2.5);" class="w-full h-full object-contain" />
          </div>
          <ul class="text-sm text-slate-300 font-light leading-loose text-left inline-block my-8 list-disc list-inside max-w-[260px]">
            <li>Divorce Representation</li>
            <li>Prenuptial Agreement</li>
            <li>Child Custody</li>
            <li>Spousal Support</li>
            <li>Divorce Mediation</li>
          </ul>
          <a href="/family-law" class="mt-auto flex items-center gap-2 text-xs font-semibold tracking-widest text-white uppercase hover:text-[#00E5FF] transition-colors">
            Learn More <span class="text-lg tracking-normal group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
          </a>
        </div>

        <div class="border border-cyan-400/20 rounded-[2.5rem] bg-[#02084b]/60 backdrop-blur-sm p-8 md:p-10 flex flex-col items-center text-center shadow-xl hover:border-[#00E5FF] hover:shadow-[0_0_30px_rgba(0,229,255,0.45)] transition-all duration-300 group">
          <h3 class="text-2xl font-serif text-white mb-8">Personal Injury</h3>
          <div style="width: 150px; height: 150px;" class="rounded-full border border-white/20 flex items-center justify-center bg-[#010636] group-hover:border-[#00E5FF]/50 transition-colors duration-300">
            <img src={injuryIcon.src} alt="Personal Injury Cast" style="transform: scale(2.6);" class="w-full h-full object-contain" />
          </div>
          <p class="text-sm text-slate-300 font-light leading-relaxed my-8 max-w-[260px]">
            Fighting for the compensation you deserve after an injury caused by someone else's negligence.
          </p>
          <a href="/personal-injury" class="mt-auto flex items-center gap-2 text-xs font-semibold tracking-widest text-white uppercase hover:text-[#00E5FF] transition-colors">
            Learn More <span class="text-lg tracking-normal group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
          </a>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; width: 100%; max-width: 80rem; border-top: 1px solid rgba(255,255,255,0.1);" class="pt-16">
        
        <div class="flex flex-col items-center text-center p-4 rounded-2xl hover:bg-white/5 transition-colors duration-200 group">
          <div class="w-32 h-32 flex-shrink-0 bg-white/5 rounded-2xl p-4 flex items-center justify-center border border-white/10 group-hover:border-cyan-400/50 group-hover:bg-[#010636] transition-all duration-300 mb-5 shadow-xl overflow-hidden">
            <img src={clientIcon.src} alt="Shield Check Icon" style="transform: scale(2.2);" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col items-center">
            <h4 class="text-sm font-semibold uppercase tracking-widest text-white mb-2">Client Focused</h4>
            <p class="text-xs text-slate-300 font-light leading-relaxed max-w-[200px]">Personalized attention for every case.</p>
          </div>
        </div>

        <div class="flex flex-col items-center text-center p-4 rounded-2xl hover:bg-white/5 transition-colors duration-200 group">
          <div class="w-32 h-32 flex-shrink-0 bg-white/5 rounded-2xl p-4 flex items-center justify-center border border-white/10 group-hover:border-cyan-400/50 group-hover:bg-[#010636] transition-all duration-300 mb-5 shadow-xl overflow-hidden">
            <img src={experienceIcon.src} alt="Courthouse Pillars Icon" style="transform: scale(2.2);" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col items-center">
            <h4 class="text-sm font-semibold uppercase tracking-widest text-white mb-2">Experienced</h4>
            <p class="text-xs text-slate-300 font-light leading-relaxed max-w-[200px]">Decades of combined legal experience.</p>
          </div>
        </div>

        <div class="flex flex-col items-center text-center p-4 rounded-2xl hover:bg-white/5 transition-colors duration-200 group">
          <div class="w-32 h-32 flex-shrink-0 bg-white/5 rounded-2xl p-4 flex items-center justify-center border border-white/10 group-hover:border-cyan-400/50 group-hover:bg-[#010636] transition-all duration-300 mb-5 shadow-xl overflow-hidden">
            <img src={discreetIcon.src} alt="Handshake Icon" style="transform: scale(2.2);" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col items-center">
            <h4 class="text-sm font-semibold uppercase tracking-widest text-white mb-2">Discreet</h4>
            <p class="text-xs text-slate-300 font-light leading-relaxed max-w-[200px]">Your case is completely confidential.</p>
          </div>
        </div>

        <div class="flex flex-col items-center text-center p-4 rounded-2xl hover:bg-white/5 transition-colors duration-200 group">
          <div class="w-32 h-32 flex-shrink-0 bg-white/5 rounded-2xl p-4 flex items-center justify-center border border-white/10 group-hover:border-cyan-400/50 group-hover:bg-[#010636] transition-all duration-300 mb-5 shadow-xl overflow-hidden">
            <img src={resultsIcon.src} alt="Trophy Icon" style="transform: scale(2.2);" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col items-center">
            <h4 class="text-sm font-semibold uppercase tracking-widest text-white mb-2">Results Driven</h4>
            <p class="text-xs text-slate-300 font-light leading-relaxed max-w-[200px]">We fight for the best possible outcome.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- Rest of your existing content continues here... -->
    
  </div>

  <style>
    @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
    .animate-fade-in { animation: fade-in 0.8s ease-in; }
    
    .hero-wrapper {
      margin-top: 0 !important;
    }
  </style>
  <Footer />
</BaseLayout>